{
  "name": "bodyvision-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare_pose_assets.mjs && node scripts/prepare_anatomy_assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare_pose_assets.mjs && node scripts/prepare_anatomy_assets.mjs",
    "build": "tsc -b && vite build",
    "assets:pose": "node scripts/prepare_pose_assets.mjs",
    "assets:anatomy": "node scripts/prepare_anatomy_assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "pretypecheck": "node scripts/prepare_pose_assets.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "pretest": "node scripts/prepare_pose_assets.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@hookform/resolvers": "7.0.7",
    "@tanstack/react-query": "5.90.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.92.0",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.15",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
