# Run: python scripts/setup_local.py. Never commit the generated .env.
APP_ENV=local
DEBUG=false
DATABASE_URL=postgresql+psycopg://bodyvision_app:GENERATED_BY_SETUP@db:5432/bodyvision
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:GENERATED_BY_SETUP@db:5432/bodyvision
POSTGRES_DB=bodyvision
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERATED_BY_SETUP
POSTGRES_APP_PASSWORD=GENERATED_BY_SETUP
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]

# Optional, private LOCAL/TEST only (requires IDENTITY_ENABLED=true and a
# separate AUTH_DATABASE_URL). The setup script does not expose private access.
# Generate the key outside source control; never reuse the MFA key.
# CAPTURE_ENCRYPTION_KEY=<fresh Fernet 32-byte key, urlsafe base64>
# Without this key, the encrypted synthetic capture archive stays disabled.
# During local/test key rotation, encrypt only with the new active key and
# temporarily supply old keys as a JSON array for read-only fallback:
# CAPTURE_DECRYPTION_KEYS=["previous-Fernet-key"]
# CAPTURE_RETENTION_INTERVAL_SECONDS=900
# CAPTURE_RETENTION_ENABLED=true  # false only for isolated automated tests
# Never commit keys; remove prior keys ONLY after verifying all archived
# ciphertext has been rotated and original bytes remain recoverable.
