{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predev": "node scripts/prepare_anatomy_assets.mjs && node scripts/prepare_camera_assets.mjs",
    "prebuild": "npm run test:body-wire && npm run test:projection && node scripts/prepare_anatomy_assets.mjs && node scripts/prepare_camera_assets.mjs",
    "test:body-wire": "node --experimental-strip-types scripts/test_body_wire.mjs",
    "test:projection": "node --experimental-strip-types scripts/test_projection.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "clsx": "2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.80.0",
    "postprocessing": "^6.39.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "tailwind-merge": "3.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
